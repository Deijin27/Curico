  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Curico.Core\Curico.Core.csproj" />
  </ItemGroup>

</Project>
